from datetime import datetime

expenses = []
budget = 0

# Generate Expense_ID
def generate_id():
    if len(expenses) == 0:
        return 1

    return expenses[-1]["id"]+1

# Display Main Menu
def show_menu():

    print("1. Add Expense")
    print("2. View All Expense")
    print("3. Search expense")
    print("4. Filter by Expense")
    print("5. Delete Expense")
    print("6. Expense Summary")
    print("7. Category-wise Summary")
    print("8. Set Monthly Budget")
    print("9. Budget Status")
    print("10. Exit")

# Get Valid Amount
def get_amount():
    while True:
        try:
            amount = float(input("Enter amount : $"))

            if amount <= 0:
                print("Amount must be greater than 0")
            else:
                return amount
        except ValueError:
            print("Please enter a valid number")


# Get Expense Date
def get_date():
    while True:
        date = input("Enter date (DD-MM-YYYY): ")

        try:
            datetime.strptime(date,"%d-%m-%y")
            return date
        except ValueError:
            print("Invalid date formate")
            print("Please use DD-MM-YYYY.")


# add expense
def add_expense():
    print("\n--------- ADD EXPENSE -------")
    title = input("Enter expense title : ").strip()

    if title == "":
        print("Title cannot be empty.")
        return

    amount = get_amount()
    category = input("Enter Category : ").strip()

    if category == "":
        print("category cannot be empty.")
        return

    date = get_date()

    expense = {
        "id": generate_id(),
        "title": title,
        "amount":amount,
        "category":category,
        "date":date
    }
    expenses.append(expense)

    print("\nExpense added successfully!")
    print("Expense ID:", expense["id"])

# Display One Expense
def display_expense(expense):
    print("ID       :", expense["id"])
    print("Title    :", expense["title"])
    print("Amount   :", format(expense["amount"],".2f"))
    print("category :", expense["category"])
    print("Date     :", expense["date"])

# View All expenses
def view_expense():
    print("\n---------------ALL EXPENSES ----------------------")

    if len(expenses) == 0:
        print("No expenses recorded")
        return

    total = 0

    for expense in expenses:
        display_expense(expense)
        total += expense("amount")

    print("-"*50)
    print("Total Expenses : Rs", format(total,".2f"))

def search_expense():
    print("\n--------- SEARCH EXPENSE ----------")

    keyword = input("Enter title or category to search: ").lower()

    found = False

    for expense in expenses:
        if (keyword in expense["title"].lower()
                or keyword in expense["category"].lower()):

            display_expense(expense)
            found = True

    if not found:
        print("No matching expenses found")

# Filter by Category
def filter_category():
    print("\n------------ FILTER BY CATEGORY ----------")

    category = input("Enter Category : ").strip().lower()

    found = False
    category_total = 0

    for expense in expenses:
        if expense["category"].lower() == category:
            display_expense(expense)

            category_total += expense["amount"]
            found = True

    if found:
        print("-"*50)
        print(
            "total Spend In ",
            category, ": Rs ",
            format(category_total, ".2f")
        )
    else:
        print("No expenses found in this category.")

# Delete Expense
def delete_expense():
    print("\n-------------- DELETE EXPENSE -----------")

    if len(expenses) == 0:
        print("No expense available.")

    try:
        expense_id = int(input("Enter Expense ID to delete : "))

    except ValueError:
        print("Invalid ID")
        return

    for expense in expenses:
        if expense["id"] == expense_id:
            print("\nExpense found: ")
            display_expense()

            confirm = input("\n Are you sure you want to delete it? (y/n): ").lower()

            if confirm == "y" or confirm == "yes":
                expenses.remove(expense)
                print("Expense deleted successfully.")
            else:
                print("Deletion cancelled.")

            return
        print("Expense ID not found")

# calculate total
def calculate_total():
    total = 0

    for expense in expenses:
        total += expense["amount"]

    return total

# calculation Average

def calculate_average():
    if len(expenses) == 0:
        return 0

    total = calculate_total()

    return total/len(expenses)

# Find Highest Expense
def find_highest_expense():
    if len(expenses) == 0:
        return None

    highest = expenses[0]

    for expense in expenses:
        if expense["amount"] > highest["amount"]:
            highest = expense

    return highest


def find_lowest_expense():
    if len(expenses) == 0:
        return None

    lowest = expenses[0]

    for expense in expenses:
        if expense["amount"] < lowest["amount"]:
            lowest = expense

    return lowest

# Expense summary
def expense_summary():
    print("\n------- EXPENSE SUMMARY ---------")

    if len(expenses) == 0:
        print("No expenses available.")
        return

    total = calculate_total()
    avergae = calculate_average()

    highest = find_highest_expense()
    lowest = find_lowest_expense()

    print("Number of expenses : ", len(expenses))
    print("total spending     : Rs", format(total, ".2f"))
    print("Avergae expense    :", format(avergae, ".2f"))

    print("\nHighest Expense: ")
    display_expense(highest)

    print("\nLowest Expense:")
    display_expense(lowest)

#  Category wise summary

def category_summary():
    print("\n-------- Category Summary ----------------")

    if len(expenses) == 0:
        print("No expenses available")
        return

    categories = {}

    for expense in expenses:
        category = expense["category"]

        if category not in categories:
            categories[category] = 0

        categories[category] += expense["amount"]

    for category, amount in categories.items():
        print(
            category, "Rs", format(amount, ".2f")
        )


# Set Budget
def set_budget():
    global budget

    print("----------- SET MONTHLY BUDGET ---------------")

    while True:
        try:
            amount = float(input("Enter monthly budget: Rs"))
            if amount <= 0:
                print("Budget must be greater than 0.")
            else:
                budget = amount

                print(
                    "Monthly Budget set to Rs",
                    format(budget, ".2f")
                )
                return
        except ValueError:
            print("Please enter a valid number")


# Budget Status
def budget_status():
    print("\n ------- BUDGET STATUS --------")

    if budget == 0:
        print("Monthly Budget has bot been set.")
        return

    total = calculate_total()
    remaining = budget - total

    print("Monthly Budget : Rs", format(budget, ".2f"))
    print("Total Spent    : rs", format(total,".2f"))

    if remaining > 0:
        print(
            "Remaining      : Rs", format(remaining, ".2f")
        )

        percentage = (total/budget)*100

        print("Budget Used    : ", format(percentage, ".2f"), "%")
    elif remaining == 0:
        print("Remaining       : Rs 0.00")
        print("Ypu have used your entire budget")
    else:
        exceeded = abs(remaining)

        print("Budget Exceeded : Rs". format(exceeded, ".2f"))
        print("WARNING : YOU HAVE EXCEEDED YOUR BUDGET!")

# main Program
def main():
    while True:
        show_menu()
        choice = input("Enter your choice : ")

        if choice == "1":
            add_expense()

        elif choice == "2":
            view_expense()

        elif choice == "3":
            search_expense()

        elif choice == "4":
            filter_category()

        elif choice == "5":
            delete_expense()

        elif choice == "6":
            expense_summary()

        elif choice == "7":
            category_summary()

        elif choice == "8":
            set_budget()

        elif choice == "9":
            budget_status()

        elif choice == "10":
            print("\nThank you for using Expense Tracker!")
            print("Goodbye!")
            break
        else:
            print("Invlaid choice. PLease try again")


main()





