from abc import ABC, abstractmethod

class Vehicle(ABC):
    def __init__(self, owner, number, model):
        self.owner = owner
        self.number = number
        self.model = model

    @abstractmethod
    def service_charge(self):
        pass

#inheritance
class Car(Vehicle):
    def service_charge(self):
        return 2000

class Bike(Vehicle):
    def service_charge(self):
        return 800

class Mechanic:
    def __init__(self, name):
        self.name = name

class ServiceJob:
    def __init__(self, vehicle, mechanic, part_cost):
        self.vehicle = vehicle
        self.mechanic = mechanic
        self.part_cost = part_cost
        self.status = "Pending"
        self.__paid = False

    # Polymorphism
    def show_bill(self):
        total = self.vehicle.service_charge() +self.part_cost
        print("Owner: ", self.vehicle.owner)
        print("Vehicle:", self.vehicle.model)
        print("Mechanic:", self.mechanic.name)
        print("Total bill : Rs", total)
        print("status: ", self.status)
        print("Payment: ", "Paid" if self.__paid else "unpaid")

    def complete_payment(self):
        if self.__paid:
            print("Bill already paid")
        else:
            self.__paid = True
            self.status = "Completed"
            print("Payment successful!")

    def start_service(self):
        if not self.__paid:
            self.status = "In Progress"
            
