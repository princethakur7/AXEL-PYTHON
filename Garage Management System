class Customer:

    def __init__(self, customer_id, name, phone):
        self.customer_id = customer_id
        self.name = name
        self.phone = phone

        self.vehicles = []

    def add_vehichle(self, vehicle):
        # associate a vehicle with this customer id
        self.vehicles.append(vehicle)

    def display_details(self):
        print(f"\nCustomer ID : {self.customer_id}")
        print(f"Name           : {self.name}")
        print(f"Phone          : {self.phone}")

        print("Vehicles: ")

        if not self.vehicles:
         print("No Vehicles registered.")
         return

        for vehicle in self.vehicles:
            print(
                f"{vehicle.registration_number}"
                f"{vehicle.brand}{vehicle.model}"
            )

class Vehicle(ABC):
    def __init__(self,registration_number, brand, model):
        self.registration_number = registration_number
        self.brand = brand
        self.model = model

    @abstractmethod
    def calculate_service_charge(self):
        pass

    def display_details(self):
        print(f"Registration : {self.registration_number}")
        print(f"Brand        : {self.brand}")
        print(f"Model        : {self.model}")


class Car(Vehicle):
