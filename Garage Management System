class service_repair:
    Valid_status = {
        "pending",
        "In Progress",
        "Completed"
    }


    def __init__(self, service_id, customer, Vehicle, mechanic, description, part_cost = 0):
        if part_cost < 0:
            raise ValueError("Part cost cannot be negative.")

        self.service_id = service_id
        self.customer = customer
        self.Vehicle = Vehicle
        self.mechanic = mechanic
        self.description = description

        self.part_cost = part_cost

        self._status = "Pending"
        self._amount_paid = 0.0

        self.created_at = datetime.now()

    @property
    def status(self):
        return self._status


    @property
    def amount_paid(self):
        return self._amount_paid

    @property
    def total_cost(self):
        service_charge = self.Vehicle.calculate_service_charge()
        return service_charge + self.part_cost

    @property
    def balance(self):
        return round(self.total_cost - self._amount_paid, 2)

