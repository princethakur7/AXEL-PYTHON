class Vehicle:

    def start(self):
        print("Vehicle started")

    def stop(self):
        print("Vehicle stopped")


class Car(Vehicle):

    def open_trunk(self):
        print("Car trunk opened")


class Bike(Vehicle):

    def kick_start(self):
        print("Bike started using kick")


car1 = Car()

car1.start()
car1.open_trunk()


bike1 = Bike()

bike1.start()
bike1.kick_start()
